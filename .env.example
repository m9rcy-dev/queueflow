# --- apps/api ---
DATABASE_URL="postgresql://queueflow:queueflow@localhost:5432/queueflow?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT (ADR-004 / G-08) — generate real secrets before any non-local use.
JWT_ACCESS_SECRET="dev-only-change-me"
JWT_ACCESS_TTL="1h"
REFRESH_TOKEN_TTL_DAYS="30"
DEVICE_TRUST_TOKEN_TTL_DAYS="90"

# Notification providers (ADR-008 / D-03 / G-29) — email and SMS are
# independently swappable, each with its own config switch. Leave SMS on
# "mock" until a real per-tenant cost cap exists (only "mock" is actually
# implemented for SMS today regardless of this setting).
EMAIL_PROVIDER="mock"
SMS_PROVIDER="mock"
PINGRAM_API_KEY=""
# Pingram's account data is regional (us/eu/ca, separate hosts) — must
# match whichever region you selected when creating the Pingram account,
# or every call 404s with "Account not found" even with a valid key.
PINGRAM_REGION="us"
PINGRAM_FROM_EMAIL="noreply@q.m9rcy.dev"

PORT="4001"
# Where customer-facing links in notifications point (Phase 13 — e.g. an
# appointment's manage page). The web app's public origin.
WEB_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:4001"
