# --- apps/api ---
DATABASE_URL="postgresql://queueflow:queueflow@localhost:5432/queueflow?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT (ADR-004 / G-08) — generate real secrets before any non-local use.
JWT_ACCESS_SECRET="dev-only-change-me"
# Authenticator-app login secrets are encrypted with this (Phase 15,
# ADR-014): 32 random bytes, base64 — e.g. `openssl rand -base64 32`.
# Required in production (the API refuses to boot without it); left blank,
# local dev uses a fixed, public development key.
AUTHENTICATOR_ENCRYPTION_KEY=""
JWT_ACCESS_TTL="1h"
REFRESH_TOKEN_TTL_DAYS="30"
DEVICE_TRUST_TOKEN_TTL_DAYS="90"

# Notification providers (ADR-008 / D-03 / G-29) — email and SMS are
# independently swappable, each with its own config switch. Leave SMS on
# "mock" until a real per-tenant cost cap exists (only "mock" is actually
# implemented for SMS today regardless of this setting).
# "smtp" sends to the local Mailpit inbox (docker compose up -d mailpit;
# read mail at http://localhost:8026) — the recommended local setting.
# "pingram" sends real email; "mock" only logs.
EMAIL_PROVIDER="smtp"
SMS_PROVIDER="mock"
PINGRAM_API_KEY=""
# Pingram's account data is regional (us/eu/ca, separate hosts) — must
# match whichever region you selected when creating the Pingram account,
# or every call 404s with "Account not found" even with a valid key.
PINGRAM_REGION="us"
PINGRAM_FROM_EMAIL="noreply@q.m9rcy.dev"
# EMAIL_PROVIDER=smtp (Phase 19). Defaults match docker-compose's Mailpit.
SMTP_HOST="localhost"
SMTP_PORT="1026"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="QueueFlow <noreply@queueflow.local>"

PORT="4001"
# Where customer-facing links in notifications point (Phase 13 — e.g. an
# appointment's manage page). The web app's public origin.
WEB_APP_URL="http://localhost:4000"
# Phase 19 — the API's own public address, for QR code images in emails
# (an email can't draw a QR; the API serves one per ticket/booking token).
API_PUBLIC_URL="http://localhost:4001"
NODE_ENV="development"

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:4001"

# Phase 19 (ADR-018) — QueueFlow's own root admins: comma-separated emails
# that can sign in at /platform (read-only view of every business). Empty =
# nobody. Removing an email locks that person out immediately.
PLATFORM_ADMIN_EMAILS=""

# --- Production (Phase 20) — see docs/runbooks/deploy.md -------------------
# NODE_ENV=production turns on the start-up checks: the API refuses to start
# without a strong JWT_ACCESS_SECRET, AUTHENTICATOR_ENCRYPTION_KEY, https
# WEB_APP_URL / API_PUBLIC_URL and a real EMAIL_PROVIDER.
# Browsers allowed to call the API; defaults to WEB_APP_URL's origin.
CORS_ORIGINS=""
# Proxies in front of the API (Render: 1), so rate limits see each visitor.
# Defaults to 1 in production, 0 locally.
TRUST_PROXY_HOPS=""
# Public business sign-up (POST /auth/business-signup). Off in production
# unless "true" — businesses are onboarded at /platform. On locally.
BUSINESS_SIGNUP_ENABLED=""
