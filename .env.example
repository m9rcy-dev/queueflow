# --- apps/api ---
DATABASE_URL="postgresql://queueflow:queueflow@localhost:5432/queueflow?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT (ADR-004 / G-08) — generate real secrets before any non-local use.
JWT_ACCESS_SECRET="dev-only-change-me"
JWT_ACCESS_TTL="1h"
REFRESH_TOKEN_TTL_DAYS="30"
DEVICE_TRUST_TOKEN_TTL_DAYS="90"

# Notification provider (ADR-008 / D-03 / G-29) — email is the default channel
# for the hobby phase. Leave SMS unset until a real per-tenant cap exists.
NOTIFICATION_PROVIDER="mock"
PINGRAM_API_KEY=""
PINGRAM_FROM_EMAIL="noreply@q.m9rcy.dev"

PORT="4001"
NODE_ENV="development"

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:4001"
