// QueueFlow — Prisma schema
//
// Phase 1 (Tenant & Core Auth, docs/roadmap.md) adds identity and
// multi-tenancy. No passwords anywhere — auth is OTP-only (ADR-004).
// Tenant isolation is enforced in application code (every query scoped by
// tenantId from the access token, ADR-003) — this schema doesn't attempt
// database-level RLS; that's a documented later hardening option, not MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person's global identity — keyed by email, since OTP auth verifies
// possession of an email, not a tenant-scoped credential. One User can hold
// memberships (TenantUser) in more than one Tenant (G-03).
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  displayName     String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   TenantUser[]
  loginCodes    LoginCode[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// A business account on QueueFlow. Distinct from customer signup (Phase 9) —
// this is the business/staff side (ADR-003).
model Tenant {
  id        String @id @default(uuid())
  name      String
  ownerName String

  // Capability toggles (G-01/ADR-005). QR Management and the live dashboard
  // are always-on for every tenant and therefore have no field here — only
  // the two genuinely optional capability modules do. `appointmentEnabled`
  // records intent only until the appointment engine (Phase C) exists.
  queueEnabled       Boolean @default(true)
  appointmentEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   TenantUser[]
  invites       TenantInvite[]
  refreshTokens RefreshToken[]
  locations     Location[]
  services      Service[]
  customers     Customer[]
  queues        Queue[]
  queueEntries  QueueEntry[]
  codes         Code[]
  deviceTrusts  DeviceTrust[]
  notifications NotificationOutbox[]

  @@map("tenants")
}

enum TenantRole {
  TENANT_OWNER
  TENANT_ADMIN
  MANAGER
  STAFF
}

// Join table granting a User a role within one Tenant. A user can have at
// most one membership per tenant (re-inviting to change role updates this
// row rather than creating a duplicate).
model TenantUser {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      TenantRole
  createdAt DateTime   @default(now())

  // Shared counter-tablet PIN switching (D-03a). Hashed with argon2id
  // (never plaintext) despite the PIN's low entropy — it's a long-lived
  // secret, unlike the short-TTL OTP codes above, so it gets the same
  // hashing budget-terry gives real passwords, not the OTP's fast sha256.
  // Lockout mirrors the OTP pattern (MAX_VERIFY_ATTEMPTS) but is tracked
  // per-membership since a shared device serves many staff at once.
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedQueueEntries QueueEntry[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_users")
}

// Shared counter-tablet trust (D-03a) — "the tablet trusts once" half of
// the reusable pattern from budget-terry's docs/trusted-device-plan.md,
// adapted: scoped to a Tenant, not a single User, since one shared device
// serves many staff who each switch in via their own PIN afterward
// (staffPinLogin). Same opaque-token-hashed-server-side shape as
// RefreshToken; rotates on every use (ADR-004's rotation pattern).
model DeviceTrust {
  id         String    @id @default(uuid())
  tenantId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("device_trusts")
}

// A pending staff invitation (G-02). Accepting one requires proving control
// of the invited email via OTP, same as any other login — the OTP itself
// lives on this row (codeHash/codeExpiresAt/codeAttempts) rather than the
// LoginCode table, since an invitee may not have a User row yet.
model TenantInvite {
  id            String     @id @default(uuid())
  tenantId      String
  email         String
  role          TenantRole
  token         String     @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  codeHash      String?
  codeExpiresAt DateTime?
  codeAttempts  Int        @default(0)
  createdAt     DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("tenant_invites")
}

// One-time email login code. Mirrors budget-terry's LoginCode shape exactly
// (ADR-004) — codeHash never the plaintext code, attempts tracked for
// lockout, consumedAt marks single-use.
model LoginCode {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_codes")
}

// Opaque rotating refresh token (ADR-004). Only its hash is ever stored;
// the plaintext is returned to the client once and never persisted.
//
// Scoped to one tenant, not just one user — a token issued while acting in
// Tenant A must not silently refresh into Tenant B's context for a
// multi-membership user. Switching tenants means going through
// select-tenant again with a fresh login.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tenantId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

// Phase 2 (Locations & Services). Deliberately no separate Staff entity yet
// (docs/roadmap.md Phase 2 note) — the queue engine (Phase 3) resolved to
// plain FIFO with no per-staff service-capability filtering (G-11), so
// TenantUser (with its role) is sufficient to represent "who's staff here."
// Revisit only if a later phase genuinely needs staff-location-service
// capability assignment.
model Location {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  // IANA timezone name (e.g. "Pacific/Auckland") — all business-hours and
  // scheduling logic (Phase 3 onward, G-16/§39) is computed in this
  // timezone, never assumed UTC.
  timezone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cross-queue cap for a repeat customer at this location (G-34) — only
  // binds once a location has more than one queue (D-04's default is one
  // queue per location, where the per-queue cap on Queue already governs).
  maxActiveTicketsPerCustomer Int @default(2)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessHours BusinessHours[]
  services      Service[]
  queues        Queue[]

  @@index([tenantId])
  @@map("locations")
}

// One row per open period. Deliberately not one-row-per-day — a location
// can have split periods (e.g. 09:00-12:00 and 13:00-17:00 the same day,
// plan §39) by having two rows with the same dayOfWeek.
model BusinessHours {
  id              String   @id @default(uuid())
  locationId      String
  dayOfWeek       Int // 0=Sunday .. 6=Saturday
  opensAtMinutes  Int // minutes since local midnight, e.g. 540 = 09:00
  closesAtMinutes Int
  createdAt       DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("business_hours")
}

model Service {
  id                 String   @id @default(uuid())
  tenantId           String
  locationId         String
  name               String
  description        String?
  durationMinutes    Int
  active             Boolean  @default(true)
  // Capability toggles, per-service (distinct from Tenant's own toggles) —
  // a business might offer a service only via queue, only via appointment
  // (Phase C), or both.
  queueEnabled       Boolean  @default(true)
  appointmentEnabled Boolean  @default(false)
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  queueServices QueueService[]
  queueEntries  QueueEntry[]

  @@index([tenantId])
  @@index([locationId])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Phase 3 (Queue Domain, docs/roadmap.md) — the highest-risk phase in the
// whole plan (docs/plan-review.md §5). No customer-facing/staff-facing UI
// yet — this is proven via API + tests only (Phases 4-5 build the UI).
// ---------------------------------------------------------------------------

// A customer is reused across visits by phone number (G-33's resolution),
// not a fresh row per join — this is what makes "max active tickets per
// customer" (G-34) even enforceable. Tenant-scoped, distinct from the
// business/staff side (User/TenantUser) entirely — customers never log in
// via this table (that's Phase 9's separate CUSTOMER_IDENTITY system).
model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  // E.164 (G-33) — normalized at the boundary, never stored in whatever
  // format the customer typed.
  phoneE164 String
  firstName String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries QueueEntry[]

  @@unique([tenantId, phoneE164])
  @@index([tenantId])
  @@map("customers")
}

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Queue {
  id                          String      @id @default(uuid())
  tenantId                    String
  // D-04: one queue per location, many services attached — this is that
  // join. A location having a second queue is a supported future config
  // choice, not a code fork.
  locationId                  String
  name                        String
  status                      QueueStatus @default(ACTIVE)
  // Plain integer (G-12) — not inferred from staff/shift records, which
  // don't exist yet. Bump if a shop runs multiple chairs.
  servingCapacity             Int         @default(1)
  // Per-customer cap within this one queue (G-34).
  maxActiveTicketsPerCustomer Int         @default(1)
  // Recall/no-show tuning, per-business-configurable (G-15 resolution).
  maxRecallCount              Int         @default(2)
  recallGracePeriodMinutes    Int         @default(5)
  // Notification thresholds, in people-ahead (G-31/Phase 7) — "you're
  // approaching" and "you're nearly next" fire once a WAITING entry's
  // position crosses these, each only once per entry (QueueEntry's own
  // *NotifiedAt columns). nearlyNext must stay <= approaching; not
  // enforced at the DB level (no cross-column CHECK in this schema style)
  // but validated wherever queue config is updated.
  approachingThreshold        Int         @default(5)
  nearlyNextThreshold         Int         @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  queueServices  QueueService[]
  entries        QueueEntry[]
  ticketCounters QueueTicketCounter[]
  codes          Code[]

  @@index([tenantId])
  @@index([locationId])
  @@map("queues")
}

// Which services this queue accepts (D-04) — a customer picks one of these
// when joining; all selected services share the one FIFO line.
model QueueService {
  id        String @id @default(uuid())
  queueId   String
  serviceId String

  queue   Queue   @relation(fields: [queueId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([queueId, serviceId])
  @@map("queue_services")
}

// Atomic ticket-number allocator (G-10/ADR-006) — one row per (queue,
// calendar day in the *location's* timezone). Incremented via an upsert
// with ON CONFLICT DO UPDATE, which Postgres guarantees is race-free
// without needing a raw SELECT ... FOR UPDATE for this particular counter.
model QueueTicketCounter {
  id          String   @id @default(uuid())
  queueId     String
  serviceDate DateTime @db.Date
  lastNumber  Int      @default(0)

  queue Queue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@unique([queueId, serviceDate])
  @@map("queue_ticket_counters")
}

enum QueueEntryStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  CANCELLED
  SKIPPED
  NO_SHOW
}

model QueueEntry {
  id         String  @id @default(uuid())
  tenantId   String
  queueId    String
  serviceId  String
  customerId String?

  // Set at CALLED (G-18) — required for the trusted-device/PIN audit trail
  // (D-03a) once Phase 5 builds the staff device; the field exists now so
  // Phase 5 doesn't need a schema change.
  assignedStaffId String?

  // Opaque, high-entropy (G-39) — the anonymous customer's only way back to
  // their own ticket (G-45). Never a sequential/guessable ID.
  publicToken String @unique

  ticketNumber Int
  serviceDate  DateTime         @db.Date
  status       QueueEntryStatus @default(WAITING)

  // Inert in MVP (G-35, D-04/G-11 resolved to plain FIFO) — kept so a
  // future priority policy is a data migration, not a schema change.
  priority Int @default(0)

  // Idempotency (G-21) — nullable; only enforced when the caller actually
  // supplies one. Postgres allows multiple NULLs under a unique index, so
  // this doesn't block ordinary duplicate-free joins.
  idempotencyKey String?

  // Recall is a notification resend, not a state change (G-15) — this
  // counter is what the (future, Phase 7) auto-no-show timeout consults.
  recallCount Int @default(0)

  joinedAt           DateTime  @default(now())
  calledAt           DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  // Notification thresholds fired at most once per entry (G-31, Phase 7) —
  // a timestamp doubles as an audit trail, not just a boolean gate.
  // RECALLED has no equivalent column: staff can explicitly resend as many
  // times as maxRecallCount allows (recallCount above already tracks
  // that), so it's never "already sent, skip."
  approachingNotifiedAt DateTime?
  nearlyNextNotifiedAt  DateTime?
  calledNotifiedAt      DateTime?

  // Optimistic-locking guard on top of Call Next's FOR UPDATE SKIP LOCKED
  // (ADR-006) — belt and suspenders for the single-entry transitions
  // (start/complete/skip/etc.) which don't go through the row-lock query.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queue         Queue       @relation(fields: [queueId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedStaff TenantUser? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  notifications NotificationOutbox[]

  @@unique([tenantId, idempotencyKey])
  @@unique([queueId, serviceDate, ticketNumber])
  @@index([queueId, status])
  @@index([customerId])
  @@map("queue_entries")
}

// ---------------------------------------------------------------------------
// Phase 7 (Notification Infrastructure, docs/roadmap.md) — the outbox
// pattern (ADR-008/G-31): a queue mutation's own transaction writes a
// PENDING row here (never sends synchronously — a queue operation must
// never block on, or fail because of, the notification provider), and a
// fire-and-forget pass afterward claims + sends each row exactly once.
// MockNotificationProvider is Phase 7's only provider — Pingram is Phase 8.
// ---------------------------------------------------------------------------

enum NotificationType {
  APPROACHING
  NEARLY_NEXT
  CALLED
  RECALLED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationOutboxStatus {
  PENDING
  SENT
}

model NotificationOutbox {
  id           String                   @id @default(uuid())
  tenantId     String
  queueEntryId String
  type         NotificationType
  channel      NotificationChannel
  // Phone (E.164) or email — resolved and fixed at enqueue time, not
  // re-derived from the customer at send time (the customer's own contact
  // details could change in between; the outbox row is what was promised).
  recipient String
  // Finalized message text at enqueue time — an outbox row is a concrete
  // thing to send, not a template reference that copy changes could alter
  // after the fact.
  body   String
  status NotificationOutboxStatus @default(PENDING)

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queueEntry QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([queueEntryId])
  @@map("notification_outbox")
}

// ---------------------------------------------------------------------------
// Phase 4 (Customer Queue UI, docs/roadmap.md) — the minimal slice of the
// unified code model (§4.5/ADR-005), scoped to just the QUEUE context type.
// Deliberately NOT the full model yet — CUSTOMER_IDENTITY/GUEST_CARD/
// APPOINTMENT_TICKET are Phases 9/10/C's job. A printed/scanned QR resolves
// through here rather than embedding a raw internal queue UUID.
// ---------------------------------------------------------------------------

enum CodeContextType {
  QUEUE
  // Phase 6 (Public Display, G-07) — a business-owned TV/board screen.
  // No auth: the display identifies itself purely via this rotatable
  // public code (owner regenerates + deactivates the old one if a screen
  // is repurposed or the link leaks), same `active` boolean every other
  // context type already uses for exactly that purpose.
  DISPLAY
}

model Code {
  id          String          @id @default(uuid())
  tenantId    String
  // Short, human-typable, printed — NOT a secret (G-39 distinguishes this
  // from queue_entry.publicToken, which is long and genuinely secret).
  publicCode  String          @unique
  contextType CodeContextType
  queueId     String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queue  Queue? @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("codes")
}
