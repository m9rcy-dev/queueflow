// QueueFlow — Prisma schema
//
// Phase 1 (Tenant & Core Auth, docs/roadmap.md) adds identity and
// multi-tenancy. No passwords anywhere — auth is OTP-only (ADR-004).
// Tenant isolation is enforced in application code (every query scoped by
// tenantId from the access token, ADR-003) — this schema doesn't attempt
// database-level RLS; that's a documented later hardening option, not MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person's global identity — keyed by email, since OTP auth verifies
// possession of an email, not a tenant-scoped credential. One User can hold
// memberships (TenantUser) in more than one Tenant (G-03).
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  displayName     String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   TenantUser[]
  loginCodes    LoginCode[]
  refreshTokens RefreshToken[]
  authenticator AuthenticatorCredential?

  @@map("users")
}

// A business account on QueueFlow. Distinct from customer signup (Phase 9) —
// this is the business/staff side (ADR-003).
model Tenant {
  id        String @id @default(uuid())
  name      String
  ownerName String

  // Capability toggles (G-01/ADR-005). QR Management and the live dashboard
  // are always-on for every tenant and therefore have no field here — only
  // the two genuinely optional capability modules do. `appointmentEnabled`
  // records intent only until the appointment engine (Phase C) exists.
  queueEnabled       Boolean @default(true)
  appointmentEnabled Boolean @default(false)

  // Phase 19 (ADR-018): which platform admin set this business up, when it
  // was onboarded from /platform rather than self-signed-up via the API.
  onboardedByEmail String?

  // Appointment slot grid (Phase 13, G-22/ADR-012) — tenant-wide, per plan
  // §70's "Appointments" settings. Slot starts step by the interval from
  // each open period's opening time; the buffer is turnaround occupied
  // after each booking; lead time and advance window bound which slots are
  // offered at all; cancel notice is the customer self-cancel cut-off (§76).
  appointmentSlotIntervalMinutes    Int   @default(15)
  appointmentBufferMinutes          Int   @default(0)
  appointmentMinLeadMinutes         Int   @default(60)
  appointmentAdvanceDays            Int   @default(30)
  appointmentCancelNoticeMinutes    Int   @default(120)
  // Phase 14 (G-25/ADR-013) — a checked-in appointment sorts ahead of
  // walk-ins from startsAt minus this window; BOOKED becomes NO_SHOW at
  // startsAt plus the grace period (§77); reminders go this many minutes
  // before startsAt (§75, never hard-coded).
  appointmentPriorityWindowMinutes  Int   @default(10)
  appointmentNoShowGraceMinutes     Int   @default(10)
  appointmentReminderOffsetsMinutes Int[] @default([1440, 120])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   TenantUser[]
  invites       TenantInvite[]
  refreshTokens RefreshToken[]
  locations     Location[]
  services      Service[]
  customers     Customer[]
  queues        Queue[]
  queueEntries  QueueEntry[]
  codes         Code[]
  deviceTrusts  DeviceTrust[]
  notifications NotificationOutbox[]
  appointments  Appointment[]
  logo          TenantLogo?

  @@map("tenants")
}

enum TenantRole {
  TENANT_OWNER
  TENANT_ADMIN
  MANAGER
  STAFF
}

// Join table granting a User a role within one Tenant. A user can have at
// most one membership per tenant (re-inviting to change role updates this
// row rather than creating a duplicate).
model TenantUser {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      TenantRole
  createdAt DateTime   @default(now())

  // Phase 16 (ADR-015): MANAGER/STAFF work at exactly one location and
  // can only see/operate that one; TENANT_OWNER/TENANT_ADMIN have null
  // (every location). Enforced by LocationAccessService on each request.
  locationId String?
  // Soft removal: a removed member can't sign in, but past queue actions
  // they performed keep their attribution (D-03a's audit trail) — a hard
  // delete would null out queue_entries.assignedStaffId. Re-inviting the
  // same person reactivates the row.
  removedAt  DateTime?
  // Phase 18: the name customers see (TV board, join page, their ticket) —
  // their own name or an alias, per business; null falls back to the
  // person's display name. The user confirmed staff names on the public
  // display are fine: it's how they build their reputation.
  publicName String?

  // Shared counter-tablet PIN switching (D-03a). Hashed with argon2id
  // (never plaintext) despite the PIN's low entropy — it's a long-lived
  // secret, unlike the short-TTL OTP codes above, so it gets the same
  // hashing budget-terry gives real passwords, not the OTP's fast sha256.
  // Lockout mirrors the OTP pattern (MAX_VERIFY_ATTEMPTS) but is tracked
  // per-membership since a shared device serves many staff at once.
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  assignedQueueEntries  QueueEntry[]
  servedQueueEntries    QueueEntry[]  @relation("QueueEntryServedBy")
  preferredQueueEntries QueueEntry[]  @relation("QueueEntryPreferredStaff")
  shifts                StaffShift[]
  editedShifts          StaffShift[]  @relation("StaffShiftEditedBy")
  bookedAppointments    Appointment[] @relation("AppointmentBookedBy")
  cancelledAppointments Appointment[] @relation("AppointmentCancelledBy")

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_users")
}

// Shared counter-tablet trust (D-03a) — "the tablet trusts once" half of
// the reusable pattern from budget-terry's docs/trusted-device-plan.md,
// adapted: scoped to a Tenant, not a single User, since one shared device
// serves many staff who each switch in via their own PIN afterward
// (staffPinLogin). Same opaque-token-hashed-server-side shape as
// RefreshToken; rotates on every use (ADR-004's rotation pattern).
model DeviceTrust {
  id         String    @id @default(uuid())
  tenantId   String
  // Phase 16 (ADR-015): a counter tablet belongs to one location — only
  // that location's staff (plus owner/admins) can PIN in on it. Null only
  // on tablets trusted before Phase 16, which stay business-wide until
  // they're trusted again.
  locationId String?
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("device_trusts")
}

// A pending staff invitation (G-02). Accepting one requires proving control
// of the invited email via OTP, same as any other login — the OTP itself
// lives on this row (codeHash/codeExpiresAt/codeAttempts) rather than the
// LoginCode table, since an invitee may not have a User row yet.
model TenantInvite {
  id            String     @id @default(uuid())
  tenantId      String
  email         String
  role          TenantRole
  // Phase 16: required for MANAGER/STAFF invites, null otherwise — copied
  // onto the membership when the invite is accepted.
  locationId    String?
  token         String     @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  codeHash      String?
  codeExpiresAt DateTime?
  codeAttempts  Int        @default(0)
  createdAt     DateTime   @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("tenant_invites")
}

// One-time email login code. Mirrors budget-terry's LoginCode shape exactly
// (ADR-004) — codeHash never the plaintext code, attempts tracked for
// lockout, consumedAt marks single-use.
model LoginCode {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_codes")
}

// Opaque rotating refresh token (ADR-004). Only its hash is ever stored;
// the plaintext is returned to the client once and never persisted.
//
// Scoped to one tenant, not just one user — a token issued while acting in
// Tenant A must not silently refresh into Tenant B's context for a
// multi-membership user. Switching tenants means going through
// select-tenant again with a fresh login.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tenantId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

// Phase 2 (Locations & Services). Deliberately no separate Staff entity yet
// (docs/roadmap.md Phase 2 note) — the queue engine (Phase 3) resolved to
// plain FIFO with no per-staff service-capability filtering (G-11), so
// TenantUser (with its role) is sufficient to represent "who's staff here."
// Revisit only if a later phase genuinely needs staff-location-service
// capability assignment.
model Location {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  // IANA timezone name (e.g. "Pacific/Auckland") — all business-hours and
  // scheduling logic (Phase 3 onward, G-16/§39) is computed in this
  // timezone, never assumed UTC.
  timezone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cross-queue cap for a repeat customer at this location (G-34) — only
  // binds once a location has more than one queue (D-04's default is one
  // queue per location, where the per-queue cap on Queue already governs).
  maxActiveTicketsPerCustomer Int @default(2)

  // Appointment pool (Phase 13, G-23/ADR-012) — how many appointments may
  // overlap at this location at once (customers never pick staff), and an
  // optional per-day ceiling (G-26's overbooking answer; null = no cap).
  appointmentCapacity   Int  @default(1)
  maxAppointmentsPerDay Int?

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessHours BusinessHours[]
  closures      LocationClosure[]
  appointments  Appointment[]
  staff         TenantUser[]
  shifts        StaffShift[]
  invites       TenantInvite[]
  deviceTrusts  DeviceTrust[]
  services      Service[]
  queues        Queue[]
  // GUEST_CARD codes only (Phase 10, D-14) — the location's physical card pool.
  codes         Code[]

  @@index([tenantId])
  @@map("locations")
}

// One row per open period. Deliberately not one-row-per-day — a location
// can have split periods (e.g. 09:00-12:00 and 13:00-17:00 the same day,
// plan §39) by having two rows with the same dayOfWeek.
model BusinessHours {
  id              String   @id @default(uuid())
  locationId      String
  dayOfWeek       Int // 0=Sunday .. 6=Saturday
  opensAtMinutes  Int // minutes since local midnight, e.g. 540 = 09:00
  closesAtMinutes Int
  createdAt       DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("business_hours")
}

// A date-specific closure (Phase 13, G-24/ADR-012) — holidays, or a
// partial-day block (a break, a staff meeting) when startMinutes/
// endMinutes are set. Always wins over BusinessHours. Only consulted by
// appointment slot generation today; the walk-in queue is still opened and
// closed by staff (G-16).
model LocationClosure {
  id           String   @id @default(uuid())
  locationId   String
  // Location-local calendar date.
  date         DateTime @db.Date
  // Both null = closed all day; otherwise a [start, end) local-minute range.
  startMinutes Int?
  endMinutes   Int?
  reason       String?
  createdAt    DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, date])
  @@map("location_closures")
}

model Service {
  id                 String   @id @default(uuid())
  tenantId           String
  locationId         String
  name               String
  description        String?
  durationMinutes    Int
  active             Boolean  @default(true)
  // Capability toggles, per-service (distinct from Tenant's own toggles) —
  // a business might offer a service only via queue, only via appointment
  // (Phase C), or both.
  queueEnabled       Boolean  @default(true)
  appointmentEnabled Boolean  @default(false)
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  queueServices QueueService[]
  queueEntries  QueueEntry[]
  appointments  Appointment[]

  @@index([tenantId])
  @@index([locationId])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Phase 3 (Queue Domain, docs/roadmap.md) — the highest-risk phase in the
// whole plan (docs/plan-review.md §5). No customer-facing/staff-facing UI
// yet — this is proven via API + tests only (Phases 4-5 build the UI).
// ---------------------------------------------------------------------------

// A customer is reused across visits by phone number (G-33's resolution),
// not a fresh row per join — this is what makes "max active tickets per
// customer" (G-34) even enforceable. Tenant-scoped, distinct from the
// business/staff side (User/TenantUser) entirely — customers never log in
// via this table (that's Phase 9's separate CUSTOMER_IDENTITY system).
model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  // E.164 (G-33) — normalized at the boundary, never stored in whatever
  // format the customer typed.
  phoneE164 String
  firstName String?
  // Phase 9: once a customer creates an account, this becomes their login
  // credential (email OTP) — unique per tenant, same multi-NULL-allowed
  // pattern as idempotencyKey elsewhere (an anonymous walk-in's Customer
  // row has no email and that's fine; only account-holders need one).
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries       QueueEntry[]
  codes         Code[]
  appointments  Appointment[]
  authenticator AuthenticatorCredential?
  loginCodes    CustomerLoginCode[]
  refreshTokens CustomerRefreshToken[]

  @@unique([tenantId, phoneE164])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Phase 9 (Customer Accounts & Portal, D-09/G-55) — a customer account
// belongs to exactly one tenant (unlike staff, who can span tenants via
// TenantUser), so there's no User/TenantUser-style split here: Customer
// itself is the login-capable entity. Mirrors LoginCode/RefreshToken's
// exact shape (ADR-004) — same OTP-hash-and-verify, same opaque rotating
// refresh token, just keyed by customerId instead of userId.
// ---------------------------------------------------------------------------

model CustomerLoginCode {
  id         String    @id @default(uuid())
  customerId String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_login_codes")
}

model CustomerRefreshToken {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_refresh_tokens")
}

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Queue {
  id                          String      @id @default(uuid())
  tenantId                    String
  // D-04: one queue per location, many services attached — this is that
  // join. A location having a second queue is a supported future config
  // choice, not a code fork.
  locationId                  String
  name                        String
  status                      QueueStatus @default(ACTIVE)
  // Plain integer (G-12) — not inferred from staff/shift records, which
  // don't exist yet. Bump if a shop runs multiple chairs.
  servingCapacity             Int         @default(1)
  // Per-customer cap within this one queue (G-34).
  maxActiveTicketsPerCustomer Int         @default(1)
  // Recall/no-show tuning, per-business-configurable (G-15 resolution).
  maxRecallCount              Int         @default(2)
  recallGracePeriodMinutes    Int         @default(5)
  // Notification thresholds, in people-ahead (G-31/Phase 7) — "you're
  // approaching" and "you're nearly next" fire once a WAITING entry's
  // position crosses these, each only once per entry (QueueEntry's own
  // *NotifiedAt columns). nearlyNext must stay <= approaching; not
  // enforced at the DB level (no cross-column CHECK in this schema style)
  // but validated wherever queue config is updated.
  approachingThreshold        Int         @default(5)
  nearlyNextThreshold         Int         @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  queueServices  QueueService[]
  entries        QueueEntry[]
  ticketCounters QueueTicketCounter[]
  codes          Code[]

  @@index([tenantId])
  @@index([locationId])
  @@map("queues")
}

// Which services this queue accepts (D-04) — a customer picks one of these
// when joining; all selected services share the one FIFO line.
model QueueService {
  id        String @id @default(uuid())
  queueId   String
  serviceId String

  queue   Queue   @relation(fields: [queueId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([queueId, serviceId])
  @@map("queue_services")
}

// Atomic ticket-number allocator (G-10/ADR-006) — one row per (queue,
// calendar day in the *location's* timezone). Incremented via an upsert
// with ON CONFLICT DO UPDATE, which Postgres guarantees is race-free
// without needing a raw SELECT ... FOR UPDATE for this particular counter.
model QueueTicketCounter {
  id          String   @id @default(uuid())
  queueId     String
  serviceDate DateTime @db.Date
  lastNumber  Int      @default(0)

  queue Queue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@unique([queueId, serviceDate])
  @@map("queue_ticket_counters")
}

enum QueueEntryStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  CANCELLED
  SKIPPED
  NO_SHOW
}

model QueueEntry {
  id         String  @id @default(uuid())
  tenantId   String
  queueId    String
  serviceId  String
  customerId String?

  // Set at CALLED (G-18) — required for the trusted-device/PIN audit trail
  // (D-03a) once Phase 5 builds the staff device; the field exists now so
  // Phase 5 doesn't need a schema change.
  assignedStaffId  String?
  // Phase 17 (ADR-016): who actually did the work — set by whoever presses
  // Start, or by a hand-over. Separate from assignedStaffId (who called),
  // because the person calling isn't always the one serving; this is what
  // per-staff reporting and pay (Phase 19) will count.
  servedByStaffId  String?
  // Phase 18 (ADR-017): who the customer wants to be served by — null means
  // anyone. Call Next only gives this entry to that person (or keeps it for
  // them); it keeps its place in line meanwhile. Cleared automatically when
  // that person clocks out.
  preferredStaffId String?

  // Opaque, high-entropy (G-39) — the anonymous customer's only way back to
  // their own ticket (G-45). Never a sequential/guessable ID.
  publicToken String @unique

  ticketNumber Int
  serviceDate  DateTime         @db.Date
  status       QueueEntryStatus @default(WAITING)

  // Inert in MVP (G-35, D-04/G-11 resolved to plain FIFO) — kept so a
  // future priority policy is a data migration, not a schema change.
  priority Int @default(0)

  // Phase 14 (§36) — set when this entry came from an appointment check-in.
  appointmentId String?   @unique
  // G-25/ADR-013: the appointment's startsAt minus the tenant's priority
  // window, fixed at check-in. Once now >= priorityFrom this entry sorts
  // ahead of every walk-in (see queue-order.ts); before that it waits in
  // plain joinedAt order. Null for every walk-in.
  priorityFrom  DateTime?

  // Idempotency (G-21) — nullable; only enforced when the caller actually
  // supplies one. Postgres allows multiple NULLs under a unique index, so
  // this doesn't block ordinary duplicate-free joins.
  idempotencyKey String?

  // Recall is a notification resend, not a state change (G-15) — this
  // counter is what the (future, Phase 7) auto-no-show timeout consults.
  recallCount Int @default(0)

  joinedAt           DateTime  @default(now())
  calledAt           DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  // Set by both cancelByStaff and cancelByPublicToken — there is no
  // separate column recording *which* path cancelled an entry (Phase 11,
  // G-14's "abandonment" metric counts every CANCELLED status the same
  // way as a result; a future split would need a new column, not a
  // schema change to this one).
  cancellationReason String?

  // Notification thresholds fired at most once per entry (G-31, Phase 7) —
  // a timestamp doubles as an audit trail, not just a boolean gate.
  // RECALLED has no equivalent column: staff can explicitly resend as many
  // times as maxRecallCount allows (recallCount above already tracks
  // that), so it's never "already sent, skip."
  approachingNotifiedAt DateTime?
  nearlyNextNotifiedAt  DateTime?
  calledNotifiedAt      DateTime?

  // Optimistic-locking guard on top of Call Next's FOR UPDATE SKIP LOCKED
  // (ADR-006) — belt and suspenders for the single-entry transitions
  // (start/complete/skip/etc.) which don't go through the row-lock query.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queue          Queue                @relation(fields: [queueId], references: [id], onDelete: Cascade)
  service        Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedStaff  TenantUser?          @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  servedByStaff  TenantUser?          @relation("QueueEntryServedBy", fields: [servedByStaffId], references: [id], onDelete: SetNull)
  preferredStaff TenantUser?          @relation("QueueEntryPreferredStaff", fields: [preferredStaffId], references: [id], onDelete: SetNull)
  notifications  NotificationOutbox[]
  // The GUEST_CARD code currently occupied by this entry, if any (Phase 10,
  // D-14) — the FK lives on Code.currentEntryId; this is just the reverse
  // side, informational only (nothing queries through it today).
  guestCard      Code?                @relation("GuestCardCurrentEntry")
  appointment    Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@unique([queueId, serviceDate, ticketNumber])
  @@index([queueId, status])
  @@index([customerId])
  @@map("queue_entries")
}

// ---------------------------------------------------------------------------
// Phase 7 (Notification Infrastructure, docs/roadmap.md) — the outbox
// pattern (ADR-008/G-31): a queue mutation's own transaction writes a
// PENDING row here (never sends synchronously — a queue operation must
// never block on, or fail because of, the notification provider), and a
// fire-and-forget pass afterward claims + sends each row exactly once.
// MockNotificationProvider is Phase 7's only provider — Pingram is Phase 8.
// ---------------------------------------------------------------------------

enum NotificationType {
  APPROACHING
  NEARLY_NEXT
  CALLED
  RECALLED
  // Phase 13 — subject is an Appointment, not a QueueEntry.
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  // Phase 14 (§75) — one per (appointment, reminderOffsetMinutes).
  APPOINTMENT_REMINDER
  // Phase 18 — the customer's preferred staff member finished their shift;
  // they're still in line, now with whoever's next free.
  PREFERRED_STAFF_UNAVAILABLE
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationOutboxStatus {
  PENDING
  SENT
}

model NotificationOutbox {
  id                    String                   @id @default(uuid())
  tenantId              String
  // Exactly one of these is set (Phase 13 made the outbox subject either a
  // queue entry or an appointment) — enforced by NotificationsService.enqueue
  // callers, not a DB CHECK, same convention as Queue's thresholds.
  queueEntryId          String?
  appointmentId         String?
  // APPOINTMENT_REMINDER only — which configured offset this row is for.
  // Part of the unique index below: Postgres treats NULLs as distinct, so
  // every non-reminder row is unaffected, while a reminder can exist at
  // most once per appointment+offset (the scheduler's idempotency, §75).
  reminderOffsetMinutes Int?
  type                  NotificationType
  channel               NotificationChannel
  // Phone (E.164) or email — resolved and fixed at enqueue time, not
  // re-derived from the customer at send time (the customer's own contact
  // details could change in between; the outbox row is what was promised).
  recipient             String
  // Finalized message text at enqueue time — an outbox row is a concrete
  // thing to send, not a template reference that copy changes could alter
  // after the fact.
  body                  String
  status                NotificationOutboxStatus @default(PENDING)

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queueEntry  QueueEntry?  @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, type, reminderOffsetMinutes])
  @@index([status])
  @@index([queueEntryId])
  @@index([appointmentId])
  @@map("notification_outbox")
}

// ---------------------------------------------------------------------------
// Phase 4 (Customer Queue UI, docs/roadmap.md) — the minimal slice of the
// unified code model (§4.5/ADR-005), scoped to just the QUEUE context type.
// Deliberately NOT the full model yet — CUSTOMER_IDENTITY/GUEST_CARD/
// APPOINTMENT_TICKET are Phases 9/10/C's job. A printed/scanned QR resolves
// through here rather than embedding a raw internal queue UUID.
// ---------------------------------------------------------------------------

enum CodeContextType {
  QUEUE
  // Phase 6 (Public Display, G-07) — a business-owned TV/board screen.
  // No auth: the display identifies itself purely via this rotatable
  // public code (owner regenerates + deactivates the old one if a screen
  // is repurposed or the link leaks), same `active` boolean every other
  // context type already uses for exactly that purpose.
  DISPLAY
  // Phase 9 — a business-owned, tenant-only code (no queue/customer
  // binding) for the self-service "sign up here" poster (D-10, G-56).
  // Resolves to just {tenant}; the customer signup/login form lives
  // behind it. Deliberately not the full LOCATION/QUEUE/SERVICE/TABLE/
  // APPOINTMENT/KIOSK/COUNTER set from §4.5/ADR-005 — build the concrete
  // case only, same discipline as QUEUE (Phase 4) and DISPLAY (Phase 6).
  GENERAL
  // Phase 9 (Customer Accounts, G-52) — a customer-owned "loyalty card"
  // code, persistent across visits, distinct from queue_entry.publicToken
  // (which is per-ticket and secret, G-45). Consumption via a physical
  // scanner for instant-join is Phase 10's job (D-11) — Phase 9 only
  // minted, displayed, and regenerated it; Phase 10 is what actually
  // consumes it (see CUSTOMER_IDENTITY scan handling in
  // QueueEntriesService.joinByScan).
  CUSTOMER_IDENTITY
  // Phase 10 (Kiosk Hardware, D-14) — a location-owned, numbered, anonymous
  // card from a fixed pool (guestNumber 1..N, admin-sized). Zero personal
  // data by design — no customer/queue binding at mint time, unlike every
  // other context type. `currentEntryId` tracks which QueueEntry currently
  // "holds" this physical card (null = free/available in the rack);
  // scanning an already-held card is idempotent (returns the existing
  // entry, G-54/D-11) rather than minting a second one. Released back to
  // the pool automatically when that entry reaches a terminal state.
  GUEST_CARD
  // Phase 14 (D-12) — one per appointment, minted with the booking. Secret
  // (long, high-entropy, like CUSTOMER_IDENTITY): scanning it checks that
  // booking in. Only the staff scan endpoint consumes it; the public
  // resolver treats it as unrecognized.
  APPOINTMENT_TICKET
}

model Code {
  id             String          @id @default(uuid())
  tenantId       String
  // Format depends on contextType (Phase 12, G-39 audit): QUEUE/DISPLAY/
  // GENERAL get the short, human-typable, printed alphabet — NOT a secret,
  // reading one only reveals which queue/tenant. CUSTOMER_IDENTITY/
  // GUEST_CARD get the same long, high-entropy format as
  // queue_entry.publicToken instead — presenting one at the scanner is a
  // real capability (instant-join as that customer / holding that card),
  // not just a context pointer. See CodesService.mintCode.
  publicCode     String          @unique
  contextType    CodeContextType
  queueId        String?
  customerId     String?
  // GUEST_CARD only, below this line.
  locationId     String?
  // The printed "guest_N" label (D-14) — distinct from publicCode (what's
  // actually scanned); staff and the physical card both show this number.
  guestNumber    Int?
  // Which QueueEntry currently "holds" this card, if any (null = free).
  // Claimed/released under a row lock in QueueEntriesService.joinByScan /
  // .transition() — see those for the concurrency reasoning.
  currentEntryId String?         @unique
  // APPOINTMENT_TICKET only.
  appointmentId  String?         @unique
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queue        Queue?       @relation(fields: [queueId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  currentEntry QueueEntry?  @relation("GuestCardCurrentEntry", fields: [currentEntryId], references: [id], onDelete: SetNull)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([locationId, guestNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([locationId])
  @@map("codes")
}

// ---------------------------------------------------------------------------
// Phase 13 (Appointment Engine, ADR-012) — future-dated bookings against a
// location's pooled capacity. Check-in (APPOINTMENT_TICKET, conversion into
// a QueueEntry, the G-25 priority rule) is Phase 14, which also adds the
// CHECKED_IN/NO_SHOW states — only the states something can reach today
// exist here.
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  BOOKED
  CANCELLED
  // Phase 14 — converted into a queue entry (§36); further progress
  // (called/served) is tracked on that entry, not duplicated here.
  CHECKED_IN
  // §77 — not checked in by startsAt + grace. Staff may restore it to
  // BOOKED the same day; noShowAt stays set as the record that it happened.
  NO_SHOW
}

// The required cancel reason (plan-review §5.5's calendar requirement) —
// an enum rather than free text so cancellation causes can be told apart
// later; `cancellationNote` carries anything more specific.
enum AppointmentCancellationReason {
  CUSTOMER_REQUESTED
  BUSINESS_INITIATED
  NO_AVAILABILITY
  BUSINESS_CLOSURE
  OTHER
}

model Appointment {
  id         String @id @default(uuid())
  tenantId   String
  locationId String
  serviceId  String
  customerId String

  // Secret (G-39/G-45) — the anonymous booker's only handle to view or
  // cancel their own appointment, same as queue_entry.publicToken.
  publicToken String @unique

  startsAt      DateTime
  // startsAt + service duration — what the customer is told.
  endsAt        DateTime
  // endsAt + the tenant's buffer at booking time — what capacity checks
  // use. Stored, not recomputed, so changing the buffer setting later never
  // retroactively shifts an existing booking's footprint (ADR-012).
  occupiedUntil DateTime
  // The location-local calendar date of startsAt — the calendar groups by
  // this, and the booking lock re-reads a whole day by it.
  localDate     DateTime @db.Date

  status AppointmentStatus @default(BOOKED)

  // G-21 pattern — unique only when supplied.
  idempotencyKey String?

  // Audit (D-03a): set when staff booked it on the customer's behalf (a
  // phone booking) rather than the customer booking it themselves.
  bookedByStaffId    String?
  cancelledAt        DateTime?
  cancellationReason AppointmentCancellationReason?
  cancellationNote   String?
  // Null with a cancellation means the customer cancelled it themselves.
  cancelledByStaffId String?

  checkedInAt DateTime?
  // Set by the no-show job and never cleared — a restored appointment keeps
  // it, which is also what stops the job re-marking it (ADR-013).
  noShowAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queueEntry    QueueEntry?
  ticketCode    Code?
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service       Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookedByStaff TenantUser?          @relation("AppointmentBookedBy", fields: [bookedByStaffId], references: [id], onDelete: SetNull)
  cancelledBy   TenantUser?          @relation("AppointmentCancelledBy", fields: [cancelledByStaffId], references: [id], onDelete: SetNull)
  notifications NotificationOutbox[]

  @@unique([tenantId, idempotencyKey])
  @@index([locationId, localDate, status])
  @@index([customerId])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Phase 15 (Authenticator App Login, ADR-014) — a time-based one-time code
// (RFC 6238) from an authenticator app, as an optional *primary* login
// method instead of the emailed code. The emailed code always stays
// available as a fallback (a lost phone never locks anyone out), so this
// is a convenience, not an extra factor.
// ---------------------------------------------------------------------------

// Owned by exactly one of a staff User or a Customer account (enforced by
// AuthenticatorService, not a DB CHECK — same convention as the outbox's
// subject). One table rather than duplicated columns, so both kinds of
// account share one implementation.
model AuthenticatorCredential {
  id         String  @id @default(uuid())
  userId     String? @unique
  customerId String? @unique

  // AES-256-GCM ciphertext of the base32 secret (authenticator-crypto.ts).
  // Encrypted, not hashed: the server needs the secret itself to compute
  // the expected code.
  secretEncrypted        String?
  // A secret shown during setup but not yet confirmed with a first code —
  // swapped into secretEncrypted on confirm, so re-setting-up on a new
  // phone never breaks the working one until the new one is proven.
  pendingSecretEncrypted String?
  // Non-null = authenticator is this account's login method.
  enabledAt              DateTime?
  // Replay protection: the last 30-second time step accepted. A code is
  // only accepted for a later step, claimed with a guarded update.
  lastUsedStep           Int?
  // Lockout, separate from the emailed code's own attempts (ADR-014).
  failedAttempts         Int       @default(0)
  lockedUntil            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("authenticator_credentials")
}

// Phase 16 (ADR-015) — the business's logo, shown on customer-facing pages.
// Its own table so the image bytes are never loaded by the many queries
// that read Tenant. Stored in Postgres (not disk — the free hosting tier's
// disk is wiped on restart; not object storage — no extra account for one
// small image per business). Capped at 500 KB, PNG/JPEG/WebP only (no SVG:
// it can carry script), checked by magic bytes, not the declared type.
model TenantLogo {
  tenantId  String   @id
  data      Bytes
  mimeType  String
  // Part of the public URL (?v=), so browsers can cache it forever and a
  // new upload is a new URL.
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_logos")
}

// Phase 18 (ADR-017) — one row per stint on the floor. "Who's working" for
// preferred-staff choices is the members with an open shift (endedAt null)
// at that location; the rows themselves are the time record Phase 19's
// hourly pay will add up. At most one open shift per member — enforced by
// a partial unique index in the migration (Prisma can't express it).
model StaffShift {
  id           String    @id @default(uuid())
  tenantId     String
  locationId   String
  tenantUserId String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  // Phase 19: set when someone corrects the times by hand, so the hours
  // report shows the record was changed and by whom.
  editedById   String?
  editedAt     DateTime?

  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tenantUser TenantUser  @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  editedBy   TenantUser? @relation("StaffShiftEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([locationId, endedAt])
  @@index([tenantUserId, startedAt])
  @@map("staff_shifts")
}
